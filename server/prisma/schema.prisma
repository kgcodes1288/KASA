generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  mcpAppApproval Boolean @default(true)
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      Role
  phone     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  emailUnsubscribed    Boolean   @default(false)
  unsubscribeToken     String?   @unique @default(cuid())
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?   @unique
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  listings                  Listing[]       @relation("HostListings")
  defaultCleanerListings    Listing[]       @relation("ListingDefaultCleaner")
  jobs                      Job[]
  coHosting                 ListingCoHost[] @relation("CoHostUser")
  maintenanceTasks          MaintenanceTask[]
  assignedByTasks           MaintenanceTask[] @relation("TaskAssignedBy")
  contractors               Contractor[]
  notifications             Notification[]
  oauthCodes                OAuthCode[]
  oauthTokens               OAuthToken[]
  tokenVersion       Int       @default(0)       // bumped on password change/reset: revokes old sessions
  emailVerifyExpires DateTime?
}

enum Role {
  host
  cleaner
}

model Listing {
  id          String    @id @default(cuid())
  name        String
  address     String?
  street      String?
  city        String?
  managementType ManagementType @default(SELF)
  icalUrl     String?
  lastSynced  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hostId      String

  defaultCleanerId  String?

  host              User              @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)
  defaultCleaner    User?             @relation("ListingDefaultCleaner", fields: [defaultCleanerId], references: [id], onDelete: SetNull)
  rooms             Room[]
  jobs              Job[]
  resetItems        ResetItem[]
  calendars         ListingCalendar[]
  bookings          Booking[]         @relation("ListingBookings")
  coHosts           ListingCoHost[]   @relation("CoHostListing")
  maintenanceTasks  MaintenanceTask[]
  jobTokens         JobToken[]
}

enum ManagementType {
  SELF
  COHOST
  HOST_WITH_COHOST
}

model ListingCoHost {
  id          String        @id @default(cuid())
  listingId   String
  userId      String?
  role        CoHostRole
  status      CoHostStatus  @default(PENDING)
  inviteToken String        @unique
  inviteEmail String?
  createdAt   DateTime      @default(now())

  listing     Listing       @relation("CoHostListing", fields: [listingId], references: [id], onDelete: Cascade)
  user        User?         @relation("CoHostUser", fields: [userId], references: [id], onDelete: Cascade)
}

enum CoHostRole {
  COHOST
  VIEW_ONLY
}

enum CoHostStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum EntityType {
  ROOM
  APPLIANCE
  SPACE
}

model Room {
  id         String     @id @default(cuid())
  name       String
  entityType EntityType @default(ROOM)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  listingId  String

  listing          Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  checklistItems   ChecklistTemplate[]
  jobs             Job[]
  resetItems       ResetItem[]
  maintenanceTasks MaintenanceTask[]
}

model MaintenanceTask {
  id               String     @id @default(cuid())
  title            String
  notes            String?
  intervalMonths   Int
  isRecurring      Boolean    @default(true)
  taskType         TaskType   @default(MAINTENANCE)
  paymentAmount    String?
  quoteStatus      QuoteStatus?
  decisionNote     String?
  decidedAt        DateTime?
  isDraft          Boolean    @default(false)
  sourceQuoteId    String?
  // purchase requests (taskType PURCHASE): what to buy, who buys it, and where it is in its life
  purchaseItems      Json?      // [{ name, qty, price?, link? }]
  purchaseMode       String?    // COHOST_BUYS (co-host buys, gets reimbursed) | OWNER_ORDERS (owner orders and ships it)
  purchaseStatus     String?    // PENDING | APPROVED | DECLINED | ORDERED | PURCHASED | RECEIVED | ISSUE
  deliveryAddress    String?
  orderInfo          Json?      // { store?, orderNumber?, trackingUrl?, eta? } filled in by the owner
  actualAmount       String?
  statusNote         String?    // co-host's note when something arrived wrong / didn't arrive
  purchaseReminderAt DateTime?
  attachments      String[]   @default([])
  lastServicedAt   DateTime?
  nextDueAt        DateTime
  status           TaskStatus @default(PENDING)
  notificationSent Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  listingId        String
  roomId           String?
  assignedUserId   String?
  assignedByUserId String?

  listing            Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  room               Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignedUser       User?                @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedBy         User?                @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  maintenanceTokens  MaintenanceToken[]
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum TaskType {
  MAINTENANCE
  ACTION
  PAYMENT_REQUEST
  QUOTE
  PURCHASE
}

enum QuoteStatus {
  PENDING
  APPROVED
  DECLINED
}

// ── New: contractor token for maintenance tasks ──────────────────────────────
model MaintenanceToken {
  id          String    @id @default(cuid())
  token       String    @unique
  phone       String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  taskId      String

  task        MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ChecklistTemplate {
  id     String @id @default(cuid())
  text   String
  order  Int    @default(0)
  roomId String

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Job {
  id             String    @id @default(cuid())
  guestName      String    @default("Airbnb Guest")
  checkoutDate   DateTime
  checkinDate    DateTime?
  status         JobStatus @default(pending)
  smsSent        Boolean   @default(false)
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  listingId      String
  roomId         String?   // legacy per-room jobs only; a turnover job has no room
  cleanerId      String?

  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  room           Room?          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cleaner        User?          @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  checklistItems JobChecklist[]
}

enum JobStatus {
  pending
  in_progress
  completed
}

model JobChecklist {
  id          String    @id @default(cuid())
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  tag         String?   // optional room/appliance name this step relates to
  jobId       String

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// One step in a listing's turnover (reset) list; copied onto each checkout job.
model ResetItem {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  listingId String
  roomId    String?  // optional tag: a room / appliance / space

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
}

model JobToken {
  id             String         @id @default(cuid())
  token          String         @unique
  phone          String
  contractorName String?
  status         JobTokenStatus @default(PENDING)
  checkoutDate   DateTime
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  listingId      String

  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

enum JobTokenStatus {
  PENDING
  ACCEPTED
  WITHDRAWN
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      NotifType
  title     String
  message   String
  read      Boolean   @default(false)
  listingId String?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotifType {
  MCP_APPROVAL
  COHOST_ACCEPTED
  JOB_CREATED
  CONTRACTOR_ACCEPTED
  CONTRACTOR_REJECTED
  CONTRACTOR_STARTED
  JOB_COMPLETED
  TASK_ASSIGNED
  QUOTE_REQUESTED
  QUOTE_DECIDED
  PURCHASE_REQUESTED
  PURCHASE_UPDATED
}

// One booking-site calendar (iCal link) for a listing: Airbnb, VRBO, Booking.com ... up to 3 per listing
model ListingCalendar {
  id         String    @id @default(cuid())
  label      String    @default("Calendar")
  url        String
  order      Int       @default(0)
  lastSynced DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  listingId  String

  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings   Booking[]
}

model Booking {
  id           String   @id @default(cuid())
  listingId    String
  checkinDate  DateTime
  checkoutDate DateTime
  guestName    String   @default("Airbnb Guest")
  icalUid      String
  type         String   @default("guest")  // "guest" | "blocked"
  calendarId   String?
  echo         Boolean  @default(false)    // same stay already reported by another calendar: hidden, no job

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listing      Listing  @relation("ListingBookings", fields: [listingId], references: [id], onDelete: Cascade)
  calendar     ListingCalendar? @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([listingId, icalUid])
}

model Contractor {
  id        String   @id @default(cuid())
  name      String
  phone     String
  trade     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hostId    String
  smsConsent Boolean @default(false)

  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}
// ── MCP connector (OAuth 2.1 for chat apps like Claude, ChatGPT, Gemini) ─────

model OAuthClient {
  id        String   @id @default(cuid())
  clientId  String   @unique
  metadata  Json
  createdAt DateTime @default(now())
}

model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  scopes        String[]
  codeChallenge String
  redirectUri   String
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  id               String    @id @default(cuid())
  accessHash       String    @unique
  refreshHash      String?   @unique
  clientId         String
  userId           String
  scopes           String[]
  resource         String?
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model McpAuditLog {
  id        String   @id @default(cuid())
  userId    String
  clientId  String?
  tool      String
  isWrite   Boolean  @default(false)
  ok        Boolean
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A high-impact action an AI assistant asked for; it only runs after the signed-in user approves it inside CleanStay.
model McpPendingAction {
  id        String   @id @default(cuid())
  userId    String
  clientId  String?
  tool      String
  argsHash  String
  preview   String
  status    String   @default("PENDING") // PENDING | APPROVED | DENIED | USED
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, status])
}

// Security-relevant events (failed sign-ins, rate-limit blocks, blocked requests, approvals). Kept 90 days. Never stores passwords, tokens or message contents.
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  ip        String?
  userId    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([ip, createdAt])
}
